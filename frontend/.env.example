# Copy to frontend/.env.local for local overrides. Every variable the frontend reads is listed here.

# The bundle holds no backend address. By default the API is same-origin under /api; a deployment
# with the API on its own URL serves /config.json with {"apiBaseUrl": "https://..."} (src/lib/runtime-config.ts).
# In local dev, `npm run dev` proxies /api to this target. Read by vite.config.ts only, never by the app.
DMC_API_PROXY_TARGET=http://localhost:8000
