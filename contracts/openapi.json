{
  "openapi": "3.1.0",
  "info": {
    "title": "DMC API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Liveness check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/examples": {
      "get": {
        "tags": [
          "examples"
        ],
        "summary": "List examples",
        "operationId": "listExamples",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 25,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamplePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/examples/{example_id}": {
      "get": {
        "tags": [
          "examples"
        ],
        "summary": "Get an example",
        "operationId": "getExample",
        "parameters": [
          {
            "name": "example_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Example Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Get the current user",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "501": {
            "description": "Not implemented",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dev/users": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "List the personas to act as (dev authentication only)",
        "operationId": "listDevUsers",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPage"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExamplePage": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/ExampleRead"
            },
            "type": "array",
            "title": "Data"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Actions",
            "description": "Actions the caller may take on `data` right now."
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "allowed_actions",
          "meta"
        ],
        "title": "ExamplePage"
      },
      "ExampleRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/ExampleStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "created_at"
        ],
        "title": "ExampleRead"
      },
      "ExampleResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ExampleRead"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Actions",
            "description": "Actions the caller may take on `data` right now."
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "allowed_actions",
          "meta"
        ],
        "title": "ExampleResponse"
      },
      "ExampleStatus": {
        "type": "string",
        "enum": [
          "draft",
          "active",
          "retired"
        ],
        "title": "ExampleStatus"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthRead"
      },
      "ListMeta": {
        "properties": {
          "evaluated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluated At",
            "description": "When the data was last evaluated, if it is derived."
          },
          "stale_after": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stale After",
            "description": "When the data should be treated as stale."
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor",
            "description": "Pass as `cursor` to get the next page; null on the last page."
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total",
            "description": "Total matching items, when cheap."
          }
        },
        "type": "object",
        "required": [
          "evaluated_at",
          "stale_after",
          "next_cursor",
          "total"
        ],
        "title": "ListMeta",
        "description": "Meta for a list: freshness plus cursor paging."
      },
      "Meta": {
        "properties": {
          "evaluated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluated At",
            "description": "When the data was last evaluated, if it is derived."
          },
          "stale_after": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stale After",
            "description": "When the data should be treated as stale."
          }
        },
        "type": "object",
        "required": [
          "evaluated_at",
          "stale_after"
        ],
        "title": "Meta",
        "description": "Freshness of the data in a response, when the data was derived by an evaluation."
      },
      "ProblemDetail": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "URI identifying the problem type; `urn:dmc:problem:<code>` for domain errors.",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short summary of the problem type."
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "HTTP status code."
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "Plain-language explanation safe to show to the user."
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance",
            "description": "The request path that failed."
          },
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "Matches the X-Request-ID response header."
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors",
            "description": "Fields that failed validation (422 only)."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "title",
          "status",
          "request_id"
        ],
        "title": "ProblemDetail",
        "description": "The one error shape every endpoint returns: RFC 9457 problem details.\n\nStructured context from a domain error is added as extension members."
      },
      "Role": {
        "type": "string",
        "enum": [
          "data_owner",
          "application_owner",
          "data_steward",
          "process_owner",
          "governance",
          "leadership",
          "auditor"
        ],
        "title": "Role",
        "description": "The roles in PRD.md §2."
      },
      "UserPage": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/UserRead"
            },
            "type": "array",
            "title": "Data"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Actions",
            "description": "Actions the caller may take on `data` right now."
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "allowed_actions",
          "meta"
        ],
        "title": "UserPage"
      },
      "UserRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Sign-in name; in dev mode, the X-DMC-Dev-User value."
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "type": "array",
            "title": "Roles"
          },
          "domain_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain Ids",
            "description": "Domains the user is scoped to; null means every domain."
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "roles",
          "domain_ids"
        ],
        "title": "UserRead"
      },
      "UserResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/UserRead"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Actions",
            "description": "Actions the caller may take on `data` right now."
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "allowed_actions",
          "meta"
        ],
        "title": "UserResponse"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc",
            "description": "Where the field is, e.g. `['query', 'limit']`."
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "description": "Plain-language message."
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Stable, machine-readable kind of failure."
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "description": "One field that failed request validation."
      }
    }
  }
}
