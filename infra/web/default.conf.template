server {
    listen 80;
    root /usr/share/nginx/html;

    # Same-origin API: the browser calls /api/v1/... on this origin (ADR 0004 §4).
    location /api/ {
        proxy_pass ${DMC_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Written at start-up from DMC_API_BASE_URL; never cached.
    location = /config.json {
        add_header Cache-Control "no-store";
        default_type application/json;
    }

    # Hashed assets never change; index.html must always be revalidated.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
