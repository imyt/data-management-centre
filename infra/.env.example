# Copy to infra/.env for local overrides. Every variable compose.yaml reads is listed here.
# These are local development credentials only; deployed environments get theirs from the secrets store.

# Host ports. Change them if the defaults are taken on your machine.
DMC_DB_PORT=5432
DMC_API_PORT=8100
DMC_WEB_PORT=8080
# Superuser, used only by the init scripts and for admin work.
POSTGRES_PASSWORD=postgres
# Roles created on first start (changing these later needs a fresh volume: docker compose down -v).
DMC_MIGRATOR_PASSWORD=dmc_migrator
DMC_APP_PASSWORD=dmc_app

# docker compose up --build only. DMC_ENVIRONMENT is reported by /api/v1/meta and shown in the UI;
# DMC_COMMIT is the git SHA baked into the image (try: DMC_COMMIT=$(git rev-parse --short HEAD)).
# DMC_API_BASE_URL goes into the web container's /config.json; leave it empty for same-origin /api/.
DMC_ENVIRONMENT=dev
DMC_COMMIT=
DMC_API_BASE_URL=
