# Copy to backend/.env for local overrides. Every variable the backend reads is listed here.

# local | test | dev | staging | production. dev, staging and production require DMC_DATABASE_URL.
DMC_ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
DMC_LOG_LEVEL=INFO
# dev | oidc. dev picks a seeded persona from the X-DMC-Dev-User header (refused in staging and
# production); oidc is not implemented yet.
DMC_AUTH_MODE=dev
# json | plain. Unset: plain in local, JSON lines (one object per line) everywhere else.
DMC_LOG_FORMAT=
# Git SHA of the build, reported by GET /api/v1/meta. Set by the deployment; unset locally, the API
# asks git for HEAD and reports "unknown" if it can't.
DMC_COMMIT=
# Comma-separated origins allowed by CORS. Empty disables CORS (same-origin only).
DMC_CORS_ORIGINS=http://localhost:5173

# Postgres (infra/compose.yaml; match the port to DMC_DB_PORT in infra/.env).
# Runtime connection for the API and worker: the dmc_app role, data access only.
DMC_DATABASE_URL=postgresql+psycopg://dmc_app:dmc_app@localhost:5432/dmc
# Used only by migrations (dmc-migrate): the dmc_migrator role, which owns the schemas.
DMC_MIGRATION_DATABASE_URL=postgresql+psycopg://dmc_migrator:dmc_migrator@localhost:5432/dmc

# Tests (pytest) use their own database, dmc_test, with the same two roles.
DMC_TEST_DATABASE_URL=postgresql+psycopg://dmc_app:dmc_app@localhost:5432/dmc_test
DMC_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://dmc_migrator:dmc_migrator@localhost:5432/dmc_test
